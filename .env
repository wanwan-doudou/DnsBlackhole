# 仓库 Compose 文件使用的默认容器版本。Compose 会自动读取根目录的 .env，
# 所以 compose.yaml / compose.host.yaml 里不再各自硬编码具体版本。
#
# 发布流程会把这里的版本号与 package.json、src-tauri/Cargo.toml、
# src-tauri/Cargo.lock、src-tauri/tauri.conf.json 一起校验，五处必须一致
# （门禁在 .github/workflows/linux-container-release.yml 的「校验版本号与发布提交」）。
DNSBLACKHOLE_VERSION=0.2.8

# 镜像仓库。只有自行构建时才需要改成本地镜像名，避免覆盖官方镜像引用：
# DNSBLACKHOLE_IMAGE_REPO=dnsblackhole
DNSBLACKHOLE_IMAGE_REPO=ghcr.io/wanwan-doudou/dnsblackhole
