[Unit]
Description=DnsBlackhole DNS 服务
Documentation=man:dnsblackhole-service(8)
# resolved 要先起来，接管事务需要它在线才能关掉 stub 监听并重新加载配置
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/dnsblackhole/dnsblackhole-service serve --data-dir /var/lib/dnsblackhole
Restart=on-failure
RestartSec=3
# 停止时走 SIGTERM，daemon 自己会恢复宿主 DNS 并保留接管意图，别让 systemd 提前强杀
KillSignal=SIGTERM
TimeoutStopSec=30

# 数据目录与运行时目录交给 systemd 创建，权限与规划的路径表一致
StateDirectory=dnsblackhole
StateDirectoryMode=0700
RuntimeDirectory=dnsblackhole
RuntimeDirectoryMode=0755

UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
# /etc 必须可写，这是实测结论而不是图省事：接管要原子替换 /etc/resolv.conf，而原子替换是
# "在 /etc 里建临时符号链接再 rename"，需要的是目录写权限。Ubuntu 26.04 上试过
# ProtectSystem=full + ReadWritePaths=/etc/resolv.conf /etc/systemd/resolved.conf.d，
# 接管会失败在"创建临时符号链接失败：Read-only file system (os error 30)"，且无法再收紧。
# 失败是 fail-closed 的（不留残留），但功能就用不了，所以这里放开整个 /etc。
ProtectSystem=true
ReadWritePaths=/etc
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# root 运行下仍收窄能力上限：绑定 53、读写并接管 resolved 配置与 /etc/resolv.conf 所需
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN

[Install]
WantedBy=multi-user.target
